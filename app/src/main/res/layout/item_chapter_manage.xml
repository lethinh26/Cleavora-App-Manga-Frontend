<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_rounded_surface"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg">

    <!-- Thông tin chapter -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_chapter_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chương 1"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_chapter_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/subtext"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Ngày đăng -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="09/05"
        android:textColor="@color/subtext"
        android:textSize="12sp" />

    <!-- Nút Sửa -->
    <ImageButton
        android:id="@+id/btn_edit_chapter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Sửa chapter"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="@color/primary"
        android:padding="6dp" />

    <!-- Nút Xoá -->
    <ImageButton
        android:id="@+id/btn_delete_chapter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Xoá chapter"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@color/error"
        android:padding="6dp" />

</LinearLayout>
